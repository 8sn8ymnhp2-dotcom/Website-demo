<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#ffffff">
<title>Stan + Blue</title>
<meta name="claude:viewport-fit-sides" content="cover">
<meta name="description" content="Stan + Blue. Our life, in one place.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&family=Inter:wght@400;500;600&display=swap">
<style>
/* Layout: Apple style product page. Frosted nav, a sticky hero where the photos fly forward in 3D as you scroll,
   two tilting product tiles, then a soft gray Trips band with a spinning dotted globe and trip cards. */
:root{
  --bg:#ffffff;
  --band:#f5f5f7;
  --card:#ffffff;
  --ink:#1d1d1f;
  --ink-2:#6e6e73;
  --ink-3:#86868b;
  --line:#d2d2d7;
  --hair:rgba(0,0,0,.08);
  --blue:#0071e3;
  --red:#d70015;
  --glass:rgba(251,251,253,.78);
  --font-display:-apple-system,BlinkMacSystemFont,"SF Pro Display","Inter Tight","Helvetica Neue",Arial,sans-serif;
  --font-body:-apple-system,BlinkMacSystemFont,"SF Pro Text","Inter","Helvetica Neue",Arial,sans-serif;
  --font-mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace;
  color-scheme:light;
}
*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
html.locked-scroll{overflow:hidden}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:17px;line-height:1.47;letter-spacing:-.012em;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;overflow-x:clip}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit}
img{max-width:100%}
::selection{background:rgba(0,113,227,.18)}
:focus-visible{outline:3px solid rgba(0,113,227,.5);outline-offset:3px;border-radius:12px}
.gutter{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.wrap{max-width:1120px;margin:0 auto}

/* Nav */
.nav{position:fixed;top:0;left:0;right:0;z-index:50;padding-top:env(safe-area-inset-top,0px);padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));background:var(--glass);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid var(--hair)}
.nav-inner{max-width:1120px;margin:0 auto;height:52px;display:flex;align-items:center;gap:28px}
.brand{font-family:var(--font-display);font-weight:700;font-size:19px;letter-spacing:-.025em;white-space:nowrap}
.brand span{color:var(--ink-3);font-weight:400}
.nav-links{display:flex;gap:26px;margin-left:auto;font-size:14px;color:var(--ink-2)}
.nav-links a{transition:color .2s}
.nav-links a:hover{color:var(--ink)}
.nav-btn{border:0;background:var(--ink);color:#fff;font-size:14px;font-weight:600;padding:7px 16px;border-radius:980px;cursor:pointer;white-space:nowrap}
@media (max-width:640px){.nav-links{display:none}.nav-btn{margin-left:auto}}

/* Hero */
.hero{position:relative;height:260vh}
.hero-stage{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden;overflow:clip;perspective:1100px}
.scene{position:absolute;inset:0;transform-style:preserve-3d;z-index:1}
.ph{position:absolute;left:50%;top:50%;margin:0;width:clamp(100px,15vw,210px);aspect-ratio:4/5;max-width:100%;border-radius:clamp(14px,1.6vw,22px);overflow:hidden;background:var(--g);box-shadow:0 40px 70px -30px rgba(18,28,48,.45),0 12px 24px -12px rgba(18,28,48,.22);transform:translate(-50%,-50%);will-change:transform,opacity;backface-visibility:hidden}
.ph:nth-child(1){--g:linear-gradient(160deg,#dbe8ff,#8fb5ff)}
.ph:nth-child(2){--g:linear-gradient(160deg,#ffe0cf,#ff9fb3)}
.ph:nth-child(3){--g:linear-gradient(160deg,#d4f3ef,#79c9e3)}
.ph:nth-child(4){--g:linear-gradient(160deg,#ffecd2,#f6b07f)}
.ph:nth-child(5){--g:linear-gradient(160deg,#eef1f6,#b8c3d3)}
.ph-center{--g:linear-gradient(165deg,#ffe2d3 0%,#ffb3c3 45%,#8cc2ff 100%)!important;width:min(86vw,640px);aspect-ratio:4/3;border-radius:28px;opacity:0}
.ph img{width:100%;height:100%;object-fit:cover;display:block}
.ph img.missing,.tile-media img.missing{display:none}
.hero-copy{position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:14px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));pointer-events:none;will-change:transform,opacity}
.hero-copy a{pointer-events:auto}
.hero-title{margin:0;font-family:var(--font-display);font-weight:700;font-size:clamp(56px,13.5vw,168px);line-height:.92;letter-spacing:-.045em;text-wrap:balance}
.hero-title .plus{color:var(--ink-3);font-weight:300}
.grad{background:linear-gradient(100deg,#0a52ff 0%,#2f8cff 48%,#6cc8ff 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-sub{margin:0;font-family:var(--font-display);font-size:clamp(19px,2.4vw,28px);font-weight:600;letter-spacing:-.02em;color:var(--ink-2)}
.hero-links{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 28px;margin-top:6px;font-size:clamp(16px,1.6vw,19px)}
.link{color:var(--blue);display:inline-flex;align-items:center;gap:4px}
.link:hover{text-decoration:underline}
.scroll-cue{position:absolute;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);z-index:2;display:flex;flex-direction:column;align-items:center;gap:8px;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3)}
.scroll-cue::after{content:"";width:1px;height:28px;background:linear-gradient(var(--ink-3),rgba(134,134,139,0));transform-origin:top;animation:cue 2.2s ease-in-out infinite}
@keyframes cue{0%,100%{transform:scaleY(.35);opacity:.4}50%{transform:scaleY(1);opacity:1}}
.hero.still{height:auto}
.hero.still .hero-stage{position:relative;height:clamp(560px,100svh,860px)}

/* Tiles */
.tiles{padding-block:clamp(56px,8vw,110px) clamp(40px,6vw,80px)}
.tile-grid{display:grid;grid-template-columns:1fr;gap:20px}
@media (min-width:760px){.tile-grid{grid-template-columns:1fr 1fr}}
.tile{position:relative;display:block;min-height:clamp(440px,50vw,600px);border-radius:30px;transform:perspective(1100px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transform-style:preserve-3d;will-change:transform;box-shadow:var(--sx,0px) var(--sy,24px) 60px -30px rgba(18,28,48,.38)}
.tile-media{position:absolute;inset:0;border-radius:inherit;overflow:hidden;background:var(--g)}
.tile-media img{position:absolute;inset:-6%;width:112%;height:112%;max-width:none;object-fit:cover;transform:translate3d(var(--px,0px),var(--py,0px),0)}
.tile-island .tile-media{--g:linear-gradient(172deg,#ffd9bd 0%,#ff9fb5 40%,#83b9ff 76%,#3f7cff 100%)}
.tile-trips .tile-media{--g:var(--band)}
.tile-shade{position:absolute;inset:0;border-radius:inherit;background:linear-gradient(to top,rgba(10,16,30,.62) 0%,rgba(10,16,30,.14) 46%,rgba(10,16,30,0) 68%);pointer-events:none}
.tile-body{position:absolute;left:0;right:0;bottom:0;padding:clamp(24px,3.4vw,40px);display:flex;flex-direction:column;align-items:flex-start;gap:8px;transform:translateZ(60px)}
.tile-island .tile-body{color:#fff}
.tile-kicker{margin:0;font-size:15px;font-weight:600;opacity:.82}
.tile-title{margin:0;font-family:var(--font-display);font-size:clamp(36px,4.6vw,56px);line-height:1;letter-spacing:-.035em;font-weight:700}
.tile-link{margin-top:6px;font-size:17px;display:inline-flex;align-items:center;gap:4px}
.tile-trips .tile-link{color:var(--blue)}
.tile:hover .tile-link{text-decoration:underline}
.mini-globe{position:absolute;left:0;top:0;width:100%;height:72%;display:block}
.glare{position:absolute;inset:0;border-radius:inherit;pointer-events:none;background:radial-gradient(circle at var(--gx,50%) var(--gy,20%),rgba(255,255,255,.4),rgba(255,255,255,0) 52%);opacity:var(--glare,0);transition:opacity .35s;transform:translateZ(1px)}

/* Trips */
.trips{background:var(--band);padding-block:clamp(72px,10vw,140px)}
#trips{scroll-margin-top:52px}
.section-head{text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px;max-width:680px;margin:0 auto}
.big-title{margin:0;font-family:var(--font-display);font-size:clamp(48px,9vw,104px);line-height:.95;letter-spacing:-.045em;font-weight:700}
.lede{margin:0;font-size:clamp(17px,1.9vw,21px);color:var(--ink-2);text-wrap:balance}
.globe-wrap{position:relative;width:min(100%,640px);aspect-ratio:1/1;max-width:100%;margin:clamp(8px,2vw,24px) auto 0}
#globe{width:100%;height:100%;display:block;cursor:grab;touch-action:pan-y;-webkit-user-select:none;user-select:none}
#globe.dragging{cursor:grabbing}
.globe-wrap.zoomed #globe{-webkit-mask-image:radial-gradient(circle closest-side,#000 88%,transparent 100%);mask-image:radial-gradient(circle closest-side,#000 88%,transparent 100%)}
.globe-ui{position:absolute;right:2px;top:6px;z-index:4;display:flex;flex-direction:column;gap:8px}
.g-btn{width:40px;height:40px;border-radius:50%;border:0;padding:0;display:grid;place-items:center;cursor:pointer;color:var(--ink);background:rgba(255,255,255,.88);-webkit-backdrop-filter:saturate(180%) blur(16px);backdrop-filter:saturate(180%) blur(16px);box-shadow:0 8px 18px -10px rgba(18,28,48,.45)}
.chip{position:absolute;left:50%;bottom:clamp(6px,3%,20px);transform:translateX(-50%);z-index:5;display:flex;align-items:center;gap:10px;max-width:calc(100% - 8px);padding:8px 8px 8px 18px;border-radius:980px;background:rgba(255,255,255,.86);-webkit-backdrop-filter:saturate(180%) blur(18px);backdrop-filter:saturate(180%) blur(18px);box-shadow:0 14px 34px -14px rgba(18,28,48,.4)}
.chip-text{display:flex;flex-direction:column;min-width:0;line-height:1.2}
.chip-place{font-size:12px;color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chip-name{font-size:16px;font-weight:700;letter-spacing:-.015em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chip-x{flex:none;width:34px;height:34px;border-radius:50%;border:0;background:var(--band);color:var(--ink-2);font-size:20px;line-height:1;cursor:pointer}
.fan{position:absolute;left:0;top:0;width:0;height:0;z-index:3;perspective:900px;pointer-events:none}
.fan-card{position:absolute;left:0;top:0;width:clamp(74px,14vw,128px);aspect-ratio:4/5;max-width:none;margin:0;padding:0;border:0;border-radius:16px;overflow:hidden;cursor:pointer;background:var(--g,var(--band));box-shadow:0 22px 40px -18px rgba(18,28,48,.5),0 6px 14px -8px rgba(18,28,48,.25);transform-origin:left center;opacity:0;pointer-events:none;transform:translate3d(0,-50%,0) scale(.3);transition:transform .7s cubic-bezier(.2,.8,.2,1) var(--d,0ms),opacity .4s var(--d,0ms)}
.fan-card img{width:100%;height:100%;object-fit:cover;display:block}
.fan-card.empty{cursor:default}
.fan-card.empty span{position:absolute;left:8px;right:8px;bottom:8px;font-size:11px;font-weight:600;line-height:1.25;color:#fff;text-shadow:0 1px 6px rgba(0,0,0,.25)}
.fan.show .fan-card{opacity:1;pointer-events:auto;transform:translate3d(var(--fxr),-50%,var(--fz)) rotateY(-24deg) rotateZ(var(--frz))}
.fan.show .fan-card.empty{pointer-events:none}
.fan.left .fan-card{left:auto;right:0;transform-origin:right center}
.fan.left.show .fan-card{transform:translate3d(var(--fxl),-50%,var(--fz)) rotateY(24deg) rotateZ(var(--frz))}
.trip-grid{margin-top:clamp(8px,2vw,20px);display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px}
.trip{position:relative;min-width:0;text-align:left;border:0;background:var(--card);border-radius:24px;padding:22px 22px 20px;min-height:210px;display:flex;flex-direction:column;align-items:flex-start;gap:6px;cursor:pointer;transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transform-style:preserve-3d;will-change:transform;box-shadow:var(--sx,0px) var(--sy,12px) 32px -20px rgba(18,28,48,.32);transition:outline-color .2s}
.trip>*{transform:translateZ(26px)}
.trip.active{outline:2px solid var(--blue);outline-offset:2px}
.trip-place{font-size:13px;font-weight:600;color:var(--ink-2)}
.trip-name{font-family:var(--font-display);font-size:26px;font-weight:700;letter-spacing:-.025em;line-height:1.1;overflow-wrap:anywhere}
.trip-coord{font-family:var(--font-mono);font-size:12px;letter-spacing:0;color:var(--ink-3);font-variant-numeric:tabular-nums}
.trip-dates{margin-top:auto;padding-top:14px;font-size:14px;color:var(--ink-2)}
.trip-open{font-size:15px;color:var(--blue);display:inline-flex;align-items:center;gap:4px}
.trip-add{background:transparent;border:1.5px dashed var(--line);box-shadow:none;align-items:center;justify-content:center;text-align:center;color:var(--ink-2)}
.trip-add .trip-name{font-size:21px;color:var(--ink)}
.trip-add .trip-dates{margin-top:0;padding-top:0}
.plus-icon{width:46px;height:46px;border-radius:50%;background:var(--card);display:grid;place-items:center;font-size:26px;line-height:1;color:var(--blue);box-shadow:0 8px 20px -10px rgba(18,28,48,.3);margin-bottom:6px}
@media (max-width:560px){.trip{min-height:0}}

/* Our story */
.story{padding-block:clamp(56px,8vw,120px) clamp(72px,10vw,140px);overflow-x:hidden;overflow-x:clip}
.tl{margin-top:clamp(28px,5vw,56px)}
.tl-stage{position:relative;height:clamp(420px,50vw,520px);perspective:1400px;touch-action:pan-y;cursor:grab;-webkit-user-select:none;user-select:none;outline:none}
.tl-stage:focus-visible{outline:3px solid rgba(0,113,227,.5);outline-offset:8px;border-radius:30px}
.tl-stage.dragging{cursor:grabbing}
.tl-card{position:absolute;left:50%;top:0;width:min(560px,82%);height:100%;transform-style:preserve-3d;will-change:transform,opacity}
.tl-inner{position:relative;height:100%;display:flex;flex-direction:column;background:var(--band);border-radius:28px;transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));box-shadow:var(--sx,0px) var(--sy,18px) 50px -28px rgba(18,28,48,.42)}
.tl-media{position:relative;flex:1;min-height:0;border-radius:28px 28px 0 0;overflow:hidden;background:var(--g)}
.tl-media img{position:absolute;inset:-6%;width:112%;height:112%;max-width:none;object-fit:cover;transform:translate3d(var(--px,0px),var(--py,0px),0);pointer-events:none}
.tl-media img.missing{display:none}
.tl-body{padding:22px 26px 24px;display:flex;flex-direction:column;align-items:flex-start;gap:6px}
.tl-date{margin:0;font-size:13px;font-weight:600;color:var(--blue);font-variant-numeric:tabular-nums}
.tl-title{margin:0;font-family:var(--font-display);font-size:clamp(26px,3.2vw,32px);font-weight:700;letter-spacing:-.025em;line-height:1.1}
.tl-text{margin:0;font-size:17px;color:var(--ink-2)}
.tl-link{margin-top:6px;border:0;background:none;padding:0;font:inherit;font-size:16px;cursor:pointer}
.tl-card:not(.is-active) .tl-link{pointer-events:none}
.tl-controls{display:flex;align-items:center;gap:14px;max-width:760px;margin:clamp(22px,3vw,34px) auto 0}
.tl-controls .g-btn:disabled{opacity:.35;cursor:default}
.tl-track{position:relative;flex:1;min-width:0;height:54px;cursor:pointer;touch-action:none}
.tl-rail{position:absolute;left:12px;right:12px;top:18px;height:4px;border-radius:4px;background:var(--line)}
.tl-progress{position:absolute;left:0;top:0;bottom:0;width:0;border-radius:4px;background:linear-gradient(90deg,#0a52ff,#6cc8ff)}
.tl-dots{position:absolute;left:12px;right:12px;top:0;bottom:0}
.tl-dot{position:absolute;top:0;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px;padding:0;border:0;background:none;color:var(--ink-3);cursor:pointer}
.tl-dot i{display:block;width:14px;height:14px;margin-top:13px;border-radius:50%;border:3px solid var(--line);background:var(--bg);box-sizing:border-box;transition:all .3s}
.tl-dot.passed i{border-color:var(--blue);background:var(--blue)}
.tl-dot.active i{width:24px;height:24px;margin-top:8px;border-color:var(--blue);background:var(--bg);box-shadow:0 0 0 6px rgba(0,113,227,.14)}
.tl-dot span{font-size:12px;font-weight:600;white-space:nowrap;max-width:120px;overflow:hidden;text-overflow:ellipsis;transition:color .3s}
.tl-dot.passed span{color:var(--ink-2)}
.tl-dot.active span{color:var(--ink)}
.tl-count{margin:12px 0 0;text-align:center;font-size:14px;color:var(--ink-2);font-variant-numeric:tabular-nums}
@media (min-width:701px){.tl-rail,.tl-dots{left:52px;right:52px}}
@media (max-width:700px){.tl-dot span{display:none}.tl-track{height:44px}}

/* Photo strip, lightbox, toast */
.strip{display:flex;gap:10px;margin-top:18px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:6px;-webkit-overflow-scrolling:touch}
.strip-ph{flex:none;width:132px;aspect-ratio:4/5;max-width:100%;padding:0;border:0;border-radius:16px;overflow:hidden;background:var(--band);scroll-snap-align:start;cursor:zoom-in}
.strip-ph img{width:100%;height:100%;object-fit:cover;display:block}
.lightbox{position:fixed;inset:0;z-index:120;display:flex;align-items:center;justify-content:center;padding:calc(56px + env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) calc(56px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px));background:rgba(10,12,18,.92);opacity:0;transition:opacity .25s;touch-action:pan-y}
.lightbox.open{opacity:1}
.lightbox img{max-width:100%;max-height:100%;border-radius:14px;object-fit:contain;box-shadow:0 30px 80px -30px rgba(0,0,0,.6)}
.lb-btn{position:absolute;border:0;border-radius:50%;width:44px;height:44px;background:rgba(255,255,255,.14);color:#fff;font-size:26px;line-height:1;cursor:pointer;display:grid;place-items:center}
.lb-x{top:calc(12px + env(safe-area-inset-top,0px));right:max(12px,env(safe-area-inset-right,0px))}
.lb-prev{left:max(12px,env(safe-area-inset-left,0px));top:50%;transform:translateY(-50%)}
.lb-next{right:max(12px,env(safe-area-inset-right,0px));top:50%;transform:translateY(-50%)}
.lb-count{position:absolute;left:0;right:0;bottom:calc(18px + env(safe-area-inset-bottom,0px));margin:0;text-align:center;font-size:13px;color:rgba(255,255,255,.75);font-variant-numeric:tabular-nums}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));z-index:130;max-width:calc(100vw - 32px);padding:12px 18px;border-radius:16px;background:rgba(29,29,31,.92);color:#fff;font-size:15px;text-align:center;opacity:0;transform:translate(-50%,10px);transition:opacity .3s,transform .3s}
.toast.show{opacity:1;transform:translate(-50%,0)}

/* Footer */
.foot{border-top:1px solid var(--hair);padding-block:26px calc(26px + env(safe-area-inset-bottom,0px));font-size:13px;color:var(--ink-3)}
.foot-inner{max-width:1120px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 16px}

/* Reveal on scroll (only for things that start below the first screen) */
.reveal{transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
.reveal.pre{opacity:0;transform:translate3d(0,44px,0) scale(.97)}

/* Sheet */
.backdrop{position:fixed;inset:0;z-index:80;background:rgba(10,14,24,.32);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);opacity:0;transition:opacity .3s}
.backdrop.open{opacity:1}
.sheet{position:fixed;z-index:90;left:0;right:0;bottom:0;max-height:88vh;overflow:auto;background:var(--bg);border-radius:26px 26px 0 0;padding:30px max(22px,env(safe-area-inset-right,0px)) calc(28px + env(safe-area-inset-bottom,0px)) max(22px,env(safe-area-inset-left,0px));box-shadow:0 -20px 60px -20px rgba(10,14,24,.35);transform:translateY(105%);transition:transform .42s cubic-bezier(.2,.8,.2,1)}
.sheet.open{transform:none}
@media (min-width:700px){
  .sheet{left:50%;right:auto;bottom:auto;top:50%;width:min(540px,calc(100vw - 48px));border-radius:28px;padding:34px 34px 30px;opacity:0;transform:translate(-50%,-46%) scale(.96);transition:transform .38s cubic-bezier(.2,.8,.2,1),opacity .25s}
  .sheet.open{opacity:1;transform:translate(-50%,-50%)}
}
