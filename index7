  const t = trips.find(x => x.id === id);
  if (!t) return;
  if (typeof t.lat !== 'number') { openSheet('trip', { id }); return; }
  big.selected = id;
  big.focus(t.lon, t.lat, 2.8);
  buildFan(id);
  $('#chip-place').textContent = t.place || 'Trip';
  $('#chip-name').textContent = t.name;
  chip.hidden = false;
  $$('.trip[data-id]').forEach(b => b.classList.toggle('active', b.dataset.id === id));
  if (scroll) {
    const r = globeWrap.getBoundingClientRect();
    if (r.top < 40 || r.bottom > innerHeight) globeWrap.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
  }
}
function deselectTrip() {
  big.selected = null;
  big.setZoom(1);
  chip.hidden = true;
  fan.classList.remove('show');
  $$('.trip.active').forEach(b => b.classList.remove('active'));
}
$('#chip-x').addEventListener('click', deselectTrip);
$('#chip-open').addEventListener('click', () => { if (big.selected) openSheet('trip', { id: big.selected }); });
function renderFan() {
  const show = !!(big.selected && big.selPos && big.zoom > 1.6);
  fan.classList.toggle('show', show);
  globeWrap.classList.toggle('zoomed', big.zoom > 1.05);
  if (big.selPos) {
    fan.style.transform = `translate(${big.selPos.x.toFixed(1)}px,${big.selPos.y.toFixed(1)}px)`;
    fan.classList.toggle('left', big.selPos.x > globeWrap.clientWidth * .6);
  }
}

/* ---------- Lightbox ---------- */
const lb = $('#lightbox'), lbImg = $('#lb-img');
let lbList = [], lbIndex = 0;
function showLb() {
  lbImg.src = lbList[lbIndex];
  $('#lb-count').textContent = lbList.length > 1 ? `${lbIndex + 1} of ${lbList.length}` : '';
  $('#lb-prev').hidden = $('#lb-next').hidden = lbList.length < 2;
}
function openLightbox(list, i) {
  if (!list.length) return;
  lbList = list; lbIndex = clamp(i, 0, list.length - 1); showLb();
  lb.hidden = false; requestAnimationFrame(() => lb.classList.add('open'));
}
function closeLightbox() { lb.classList.remove('open'); setTimeout(() => { lb.hidden = true; }, reduce ? 0 : 250); }
const lbStep = k => { lbIndex = (lbIndex + k + lbList.length) % lbList.length; showLb(); };
$('#lb-x').addEventListener('click', closeLightbox);
$('#lb-prev').addEventListener('click', e => { e.stopPropagation(); lbStep(-1); });
$('#lb-next').addEventListener('click', e => { e.stopPropagation(); lbStep(1); });
lb.addEventListener('click', e => { if (e.target === lb) closeLightbox(); });
let lbSwipe = null;
lb.addEventListener('pointerdown', e => { lbSwipe = e.clientX; });
lb.addEventListener('pointerup', e => { if (lbSwipe != null && Math.abs(e.clientX - lbSwipe) > 45 && lbList.length > 1) lbStep(e.clientX < lbSwipe ? 1 : -1); lbSwipe = null; });

/* ---------- Trip cards ---------- */
let user = null, auth = null, db = null;
function renderTrips() {
  const grid = $('#trip-grid');
  grid.innerHTML = trips.map(t => {
    const n = photosFor(t.id).length;
    return `
    <button class="trip tilt" type="button" data-id="${esc(t.id)}">
      <span class="trip-place">${esc(t.place || 'Place not added')}</span>
      <span class="trip-name">${esc(t.name)}</span>
      <span class="trip-coord">${typeof t.lat === 'number' ? fmtCoord(t.lat, t.lon) : 'No pin yet'}</span>
      <span class="trip-dates">${esc(t.dates || 'Dates not added yet')}${n ? ` · ${n} ${n === 1 ? 'photo' : 'photos'}` : ''}</span>
      <span class="trip-open">See it on the globe <span aria-hidden="true">›</span></span>
    </button>`;
  }).join('') + `
    <button class="trip trip-add tilt" type="button" id="add-trip">
      <span class="plus-icon" aria-hidden="true">+</span>
      <span class="trip-name">Add a trip</span>
      <span class="trip-dates">${user ? 'Pin a new place on the globe' : 'Log in to add a trip'}</span>
    </button>`;
  $$('.trip', grid).forEach(bindTilt);
  $$('.trip[data-id]', grid).forEach(b => b.addEventListener('click', () => selectTrip(b.dataset.id, true)));
  $('#add-trip').addEventListener('click', () => user ? openSheet('add') : openSheet('login', { next: 'add' }));
  if (big.selected) $$('.trip[data-id]', grid).forEach(b => b.classList.toggle('active', b.dataset.id === big.selected));
  const pins = trips.filter(t => typeof t.lat === 'number');
  big.setPins(pins); mini.setPins(pins);
  $('#trip-count').textContent = `${pins.length} ${pins.length === 1 ? 'trip' : 'trips'} on the map`;
}

/* ---------- Sheet (trip details, log in, add a trip) ---------- */
const sheet = $('#sheet'), backdrop = $('#backdrop'), sheetBody = $('#sheet-body');
let sheetState = null, lastFocus = null;
const setStatus = (msg, err) => { const s = $('#status'); if (s) { s.textContent = msg; s.classList.toggle('err', !!err); } };
function openSheet(mode, data) {
  sheetState = Object.assign({ mode }, data || {});
  if (sheet.hidden) {
    lastFocus = document.activeElement;
    sheet.hidden = false; backdrop.hidden = false;
    requestAnimationFrame(() => requestAnimationFrame(() => { sheet.classList.add('open'); backdrop.classList.add('open'); }));
    document.documentElement.classList.add('locked-scroll');
  }
  drawSheet();
}
function closeSheet() {
  if (sheet.hidden) return;
  sheet.classList.remove('open'); backdrop.classList.remove('open');
  document.documentElement.classList.remove('locked-scroll');
  sheetState = null;
  setTimeout(() => { if (!sheetState) { sheet.hidden = true; backdrop.hidden = true; } }, reduce ? 0 : 420);
  if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
}
backdrop.addEventListener('click', closeSheet);
$('#sheet-close').addEventListener('click', closeSheet);
addEventListener('keydown', e => {
  if (!lb.hidden) {
    if (e.key === 'Escape') closeLightbox();
    else if (e.key === 'ArrowRight' && lbList.length > 1) lbStep(1);
    else if (e.key === 'ArrowLeft' && lbList.length > 1) lbStep(-1);
    return;
  }
  if (e.key === 'Escape') { if (!sheet.hidden) closeSheet(); else if (big.selected) deselectTrip(); }
});

const NOT_CONNECTED = 'Login turns on once the Firebase settings are added to this page.';
const ts = () => firebase.firestore.FieldValue.serverTimestamp();
async function geocode(q) {
  try {
    const r = await fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&q=' + encodeURIComponent(q), { headers: { 'Accept-Language': 'en' } });
    const j = await r.json();
    if (j && j[0]) return { lat: +j[0].lat, lon: +j[0].lon };
  } catch (_) {}
  return null;
}
function photoStrip(id) {
  const list = photosFor(id);
  if (!list.length) return '';
  return `<div class="strip">${list.map((src, i) => `<button class="strip-ph" type="button" data-i="${i}" aria-label="Open photo ${i + 1}"><img data-photo src="${esc(src)}" alt="" loading="lazy"></button>`).join('')}</div>`;
}
function bindStrip(id) {
  const list = photosFor(id);
  watchPhotos(sheetBody);
  $$('.strip-ph', sheetBody).forEach(b => b.addEventListener('click', () => openLightbox(list, +b.dataset.i)));
}

function drawSheet() {
  const s = sheetState;
  if (!s) return;
  if (s.mode === 'trip') {
    const t = trips.find(x => x.id === s.id);
    if (!t) return closeSheet();
    const head = `<p class="kicker">${esc(t.place || 'Trip')}</p><h2 id="sheet-title">${esc(t.name)}</h2>
      <div class="meta-row"><span id="sheet-dates">${esc(t.dates || 'Dates not added yet')}</span>${typeof t.lat === 'number' ? `<span class="mono">${fmtCoord(t.lat, t.lon)}</span>` : ''}</div>${photoStrip(t.id)}`;
    if (!user) {
      sheetBody.innerHTML = head + `<div class="locked"><span class="lock" aria-hidden="true">${LOCK}</span><strong>The itinerary is private</strong><p>Log in to see notes, plans, and reservations.</p><button class="btn" type="button" id="go-login">Log In</button></div>`;
      bindStrip(t.id);
      $('#go-login').addEventListener('click', () => openSheet('login', { next: 'trip', id: t.id }));
      return;
    }
    sheetBody.innerHTML = head + `<form id="trip-form" novalidate>
      ${t.seeded ? '' : '<div class="field"><label for="f-place">Place</label><input id="f-place" type="text" autocomplete="off" placeholder="City, country"></div>'}
      <div class="field"><label for="f-dates">Dates</label><input id="f-dates" type="text" autocomplete="off" placeholder="Sept 12 to 14, 2026"></div>
      <div class="field"><label for="f-notes">Itinerary and notes</label><textarea id="f-notes" placeholder="Flights, hotel, reservations, ideas"></textarea></div>
      <div class="actions"><button class="btn" type="submit">Save</button>${t.seeded ? '' : '<button class="btn quiet" type="button" id="del-trip">Delete trip</button>'}</div>
      <p class="status" id="status" role="status"></p></form>`;
    bindStrip(t.id);
    $('#f-dates').value = t.dates || '';
    if (!t.seeded) $('#f-place').value = t.place || '';
    const notes = $('#f-notes');
    notes.disabled = true; notes.placeholder = 'Loading notes…';
    db.collection('tripDetails').doc(t.id).get()
      .then(doc => { if (sheetState && sheetState.id === t.id) notes.value = doc.exists ? (doc.data().notes || '') : ''; })
      .catch(() => setStatus("Couldn't load the notes. Check your connection and try again.", true))
      .finally(() => { notes.disabled = false; notes.placeholder = 'Flights, hotel, reservations, ideas'; });
    $('#trip-form').addEventListener('submit', ev => { ev.preventDefault(); saveTrip(t); });
    const del = $('#del-trip');
    if (del) del.addEventListener('click', () => confirmDelete(t));
  } else if (s.mode === 'login') {
    sheetBody.innerHTML = `<p class="kicker">Stan + Blue</p><h2 id="sheet-title">Log in</h2>
      <p class="sub">Trip notes and plans are private. Only Stan and Blue have accounts.</p>
      <form id="login-form" novalidate>
        <div class="field"><label for="l-email">Email</label><input id="l-email" type="email" autocomplete="email" inputmode="email"></div>
        <div class="field"><label for="l-pass">Password</label><input id="l-pass" type="password" autocomplete="current-password"></div>
        <div class="actions"><button class="btn" type="submit">Log In</button></div>
        <p class="status" id="status" role="status"></p>
      </form>`;
    if (!configured) setStatus(NOT_CONNECTED);
    $('#login-form').addEventListener('submit', async ev => {
      ev.preventDefault();
      if (!configured) return setStatus(NOT_CONNECTED, true);
      if (!auth) return setStatus('Still connecting. Try again in a moment.', true);
      const email = $('#l-email').value.trim(), pass = $('#l-pass').value;
      if (!email || !pass) return setStatus('Enter your email and password.', true);
      setStatus('Logging in…');
      try { await auth.signInWithEmailAndPassword(email, pass); }
      catch (err) {
        const c = err && err.code || '';
        setStatus(c.includes('too-many') ? 'Too many tries. Wait a minute, then try again.'
          : c.includes('network') ? "Couldn't reach the server. Check your connection and try again."
          : "That email and password don't match. Try again.", true);
      }
    });
    setTimeout(() => { const f = $('#l-email'); if (f) f.focus({ preventScroll: true }); }, 60);
  } else if (s.mode === 'add') {
    sheetBody.innerHTML = `<p class="kicker">Trips</p><h2 id="sheet-title">Add a trip</h2>
      <form id="add-form" novalidate>
        <div class="field"><label for="a-name">Trip name</label><input id="a-name" type="text" autocomplete="off" placeholder="Weekend in Atlanta"></div>
        <div class="field"><label for="a-place">Place</label><input id="a-place" type="text" autocomplete="off" placeholder="City, country"></div>
        <div class="field"><label for="a-dates">Dates</label><input id="a-dates" type="text" autocomplete="off" placeholder="Nov 6 to 8, 2026"></div>
        <div class="field"><label for="a-notes">Itinerary and notes</label><textarea id="a-notes" placeholder="Flights, hotel, reservations, ideas"></textarea></div>
        <div class="actions"><button class="btn" type="submit">Add Trip</button></div>
        <p class="status" id="status" role="status"></p>
      </form>`;
    $('#add-form').addEventListener('submit', async ev => {
      ev.preventDefault();
      const name = $('#a-name').value.trim(), place = $('#a-place').value.trim(), dates = $('#a-dates').value.trim(), notes = $('#a-notes').value;
      if (!name) return setStatus('Give the trip a name.', true);
      setStatus(place ? 'Finding it on the map…' : 'Adding…');
      const spot = place ? await geocode(place) : null;
      try {
        const ref = await db.collection('trips').add({ name, place, dates, lat: spot ? spot.lat : null, lng: spot ? spot.lon : null, createdAt: ts() });
        if (notes) await db.collection('tripDetails').doc(ref.id).set({ notes, updatedAt: ts(), updatedBy: (user && user.email) || '' });
        if (spot) { closeSheet(); setTimeout(() => selectTrip(ref.id, true), 400); }
        else setStatus(place ? "Added. That place didn't match a spot on the map, so the trip has no pin yet. Open the trip to fix the place." : 'Added.');
      } catch (_) { setStatus("Couldn't add the trip. Check your connection and try again.", true); }
    });
    setTimeout(() => { const f = $('#a-name'); if (f) f.focus({ preventScroll: true }); }, 60);
  }
}
async function saveTrip(t) {
  const dates = $('#f-dates').value.trim(), notes = $('#f-notes').value;
  const placeEl = $('#f-place'), place = placeEl ? placeEl.value.trim() : null;
  setStatus('Saving…');
  try {
    const pub = { dates };
    if (placeEl && place !== (t.place || '')) {
      const spot = place ? await geocode(place) : null;
      Object.assign(pub, { place, lat: spot ? spot.lat : null, lng: spot ? spot.lon : null });
    }
    await db.collection('trips').doc(t.id).set(pub, { merge: true });
    await db.collection('tripDetails').doc(t.id).set({ notes, updatedAt: ts(), updatedBy: (user && user.email) || '' }, { merge: true });
    const sd = $('#sheet-dates'); if (sd) sd.textContent = dates || 'Dates not added yet';
    setStatus('Saved.');
  } catch (_) { setStatus("Couldn't save. Check your connection and try again.", true); }
}
function confirmDelete(t) {
  const actions = $('.actions', sheetBody);
  actions.innerHTML = `<span class="confirm-text">Delete ${esc(t.name)}? This removes its notes too.</span>
    <button class="btn danger" type="button" id="del-yes">Delete</button><button class="btn quiet" type="button" id="del-no">Keep</button>`;
  $('#del-no').addEventListener('click', drawSheet);
  $('#del-yes').addEventListener('click', async () => {
    try {
      await db.collection('tripDetails').doc(t.id).delete();
      await db.collection('trips').doc(t.id).delete();
      closeSheet();
      if (big.selected === t.id) deselectTrip();
    } catch (_) { setStatus("Couldn't delete the trip. Check your connection and try again.", true); }
  });
}

/* ---------- Account ---------- */
const accountBtn = $('#account-btn');
const updateAccount = () => { accountBtn.textContent = user ? 'Log Out' : 'Log In'; };
accountBtn.addEventListener('click', () => { if (user && auth) auth.signOut(); else openSheet('login'); });

/* ---------- Firebase (loads only once the settings above are filled in) ---------- */
const configured = typeof firebaseConfig === 'object' && firebaseConfig && !String(firebaseConfig.apiKey || '').startsWith('YOUR_');
const loadScript = src => new Promise((res, rej) => { const s = document.createElement('script'); s.src = src; s.onload = res; s.onerror = rej; document.head.appendChild(s); });
async function initFirebase() {
  if (!configured) return;
  try {
    const base = 'https://cdn.jsdelivr.net/npm/firebase@10.12.2/';
    await loadScript(base + 'firebase-app-compat.js');
    await Promise.all([loadScript(base + 'firebase-auth-compat.js'), loadScript(base + 'firebase-firestore-compat.js')]);
    firebase.initializeApp(firebaseConfig);
    auth = firebase.auth();
    db = firebase.firestore();
    auth.onAuthStateChanged(u => {
      user = u; updateAccount(); renderTrips();
      if (!sheetState) return;
      if (sheetState.mode === 'login' && u) {
        const next = sheetState.next;
        if (next === 'trip') openSheet('trip', { id: sheetState.id });
        else if (next === 'add') openSheet('add');
        else closeSheet();
      } else drawSheet();
    });
    db.collection('trips').onSnapshot(snap => {
      const remote = {};
      snap.forEach(doc => { remote[doc.id] = doc.data(); });
      const list = SEED.map(t => Object.assign({}, t, { seeded: true, dates: (remote[t.id] && remote[t.id].dates) || '' }));
      Object.keys(remote).filter(id => !SEED.some(t => t.id === id)).map(id => {
        const d = remote[id];
        return { id, name: d.name || 'Trip', place: d.place || '', dates: d.dates || '', lat: typeof d.lat === 'number' ? d.lat : null, lon: typeof d.lng === 'number' ? d.lng : null, seed: (id.charCodeAt(0) % 10) / 10, created: d.createdAt && d.createdAt.toMillis ? d.createdAt.toMillis() : Date.now() };
      }).sort((a, b) => a.created - b.created).forEach(t => list.push(t));
      trips = list;
      renderTrips();
    }, err => console.warn('Trips could not load', err));
  } catch (err) { console.warn('Firebase could not load', err); }
}

/* ---------- Run ---------- */
renderStory();
renderTrips();
$$('.tilt').forEach(bindTilt);

// Reveal: only things that start below the first screen fade up
if (!reduce && 'IntersectionObserver' in window) {
  const io = new IntersectionObserver(entries => entries.forEach(en => {
    if (en.isIntersecting) { en.target.classList.remove('pre'); io.unobserve(en.target); }
  }), { rootMargin: '0px 0px -8% 0px' });
  $$('.reveal').forEach(el => { if (el.getBoundingClientRect().top > innerHeight) { el.classList.add('pre'); io.observe(el); } });
}

renderHero();
globes.forEach(gl => gl.draw());
let last = performance.now();
function frame(now) {
  const dt = Math.min(.05, (now - last) / 1000); last = now;
  renderHero();
  renderTilts();
  renderTimeline(dt);
  for (const gl of globes) if (gl.visible) { gl.t += dt; gl.step(dt); gl.draw(); }
  renderFan();
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);
initFirebase();
})();
</script>

</body>
